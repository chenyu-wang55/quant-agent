# Runtime
DATABASE_URL=sqlite:////absolute/path/to/quant-agent/quant_agent_v2.db
DATA_PROVIDER=yfinance
QUANT_AGENT_TEST_MODE=0
QUANT_AGENT_DISABLE_AUTH=0

# Authentication (generate unique values; never commit real secrets)
QUANT_AGENT_ACCESS_PASSWORD=replace-with-at-least-12-random-characters
QUANT_AGENT_AUTH_SIGNING_SECRET=replace-with-at-least-32-random-characters
QUANT_AGENT_COOKIE_SECURE=0

# Licensed point-in-time data and retained validation evidence
POINT_IN_TIME_UNIVERSE_CSV=/absolute/path/to/universe.csv
POINT_IN_TIME_FUNDAMENTALS_CSV=/absolute/path/to/fundamentals.csv
POINT_IN_TIME_EVENTS_CSV=/absolute/path/to/events.csv
POINT_IN_TIME_EARNINGS_CSV=/absolute/path/to/earnings.csv
POINT_IN_TIME_VALIDATION_REPORT=/absolute/path/to/pit-validation.json
POINT_IN_TIME_REQUIRED_UNIVERSES=SP500,NASDAQ100
POINT_IN_TIME_MIN_SP500_CONSTITUENTS=450
POINT_IN_TIME_MIN_NASDAQ100_CONSTITUENTS=90

# Broker (start with Alpaca paper; do not use a live endpoint during paper acceptance)
QUANT_BROKER_ADAPTER=alpaca
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_API_KEY=replace-with-paper-key
ALPACA_SECRET_KEY=replace-with-paper-secret

# Live automation remains disabled until all readiness gates pass
QUANT_ALLOW_AUTOPILOT_LIVE=0

# Structured rotating logs
QUANT_AGENT_LOG_FORMAT=json
QUANT_AGENT_LOG_FILE=/absolute/path/to/logs/quant-agent.json.log
QUANT_AGENT_LOG_MAX_BYTES=20971520
QUANT_AGENT_LOG_BACKUP_COUNT=10
